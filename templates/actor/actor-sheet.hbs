<form class="lnd-sheet" autocomplete="off">
  <header>
    <div class="images">
      <figure>
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{localize "LND.Portrait"}}" alt="{{actor.name}}">
        <figcaption>{{localize "LND.Portrait"}}</figcaption>
      </figure>
      <figure>
        <img class="token-img" src="{{actor.prototypeToken.texture.src}}" data-edit="prototypeToken.texture.src" title="{{localize "LND.Token"}}" alt="Token">
        <figcaption>{{localize "LND.Token"}}</figcaption>
      </figure>
    </div>
    <input type="text" name="name" value="{{actor.name}}" placeholder="Nom">
    <label>{{localize "LND.Health"}}
      <span class="health-values">
        <input type="number" name="system.sante.value" value="{{system.sante.value}}"> /
        <input type="number" name="system.sante.max" value="{{system.sante.max}}">
      </span>
    </label>
    <strong>{{localize "LND.Armor"}}: {{system.armure}}</strong>
  </header>
  <section class="stats">
    {{#each statList}}
    <div class="stat">
      <a class="stat-roll" data-stat="{{key}}">{{localize (concat "LND." key)}}</a>
      <input type="number" name="system.stats.{{key}}.value" value="{{value}}">
      {{!-- <select name="system.stats.{{key}}.rank">
        <option value="high" {{#if (eq rank "high")}}selected{{/if}}>{{localize "LND.High"}}</option>
        <option value="medium" {{#if (eq rank "medium")}}selected{{/if}}>{{localize "LND.Medium"}}</option>
        <option value="low" {{#if (eq rank "low")}}selected{{/if}}>{{localize "LND.Low"}}</option>
      </select> --}}
      <span>{{#if (gte mod 0)}}+{{/if}}{{mod}}</span>
    </div>
    {{/each}}
  </section>
  {{!-- <section class="actions">
    <button type="button" data-action="heal">{{localize "LND.Heal"}}</button>
    <button type="button" data-action="move">{{localize "LND.Move"}}</button>
    <button type="button" data-action="interact">{{localize "LND.Interact"}}</button>
    <button type="button" data-action="other">{{localize "LND.Other"}}</button>
  </section> --}}
  {{#*inline "list"}}
  <h3>{{title}}</h3>
  <ol>
    {{#each items}}
    <li data-item-id="{{_id}}">
      <span>{{name}}</span>
      {{#if ../usable}}<a class="item-use" title="Utiliser"><i class="fas fa-dice-d10"></i></a>{{/if}}
      <a class="item-edit"><i class="fas fa-edit"></i></a>
      <a class="item-delete"><i class="fas fa-trash"></i></a>
    </li>
    {{/each}}
  </ol>
  {{/inline}}
  {{> list title=(localize "LND.Attack") items=weapons usable=true}}
  {{> list title=(localize "LND.Spells") items=spells usable=true}}
  {{> list title=(localize "LND.Skills") items=skills usable=true}}
  {{> list title=(localize "LND.Objects") items=objects usable=false}}
</form>
